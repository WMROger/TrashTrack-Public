# ============================================================================
# TrashTrack Danao City — Environment Configuration Template (.env.example)
# ============================================================================
# SECURITY NOTICE:
# 1. NEVER commit your actual `.env` or `functions/.env` to git.
# 2. Any variable prefixed with `EXPO_PUBLIC_` is embedded into the client bundle.
#    Only public Firebase project identifiers, public OAuth Client IDs, and
#    domain-restricted Maps keys belong in `EXPO_PUBLIC_*`.
# 3. Private secrets (GEMINI_API_KEY, SMTP credentials, N8N_API_KEY) MUST be
#    stored ONLY in `functions/.env` or Google Cloud Secret Manager.
# ============================================================================

# --- Public Firebase Client SDK Identifiers (Restricted via GCP Console + App Check) ---
EXPO_PUBLIC_FIREBASE_API_KEY=your_restricted_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# --- Google Maps SDK (Restrict by Android SHA-1 + Package com.trashtrack.danao) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_sha1_restricted_google_maps_key

# --- Public OAuth Client IDs ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id

# --- Public Unsigned Upload Cloud Name & Preset (Cloudinary) ---
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=trashtrack_reports

# ============================================================================
# SERVER-ONLY SECRETS (Place in `functions/.env` — NEVER prefix with EXPO_PUBLIC_)
# ============================================================================
# GEMINI_API_KEY=your_private_server_only_gemini_api_key
# AI_DAILY_USER_CAP=20
# AI_DAILY_GLOBAL_CAP=500
# N8N_WEBHOOK_SECRET=your_private_n8n_secret

