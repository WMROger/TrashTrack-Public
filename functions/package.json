{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "node --check index.js && node --check lib/core.js && node --check lib/rewards.js",
    "test": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --config ../firebase.test.json --project trashtrack-rules-test --only firestore \"node --test test/firestore.rules.test.js\""
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "^15.26.0"
  },
  "private": true
}
